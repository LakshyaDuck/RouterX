# ==============================================================================
# RouterX - Backend Environment Configuration
# ==============================================================================

# PostgreSQL connection string
# Examples:
#   Local Docker: postgresql://postgres:postgres@localhost:5432/fleet_db
#   Production:   postgresql://user:password@db.provider.internal:5432/fleet_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet_db

# Environment mode ('production', 'development', 'test')
ENVIRONMENT=production

# Server bind host and port
HOST=0.0.0.0
PORT=8000

# Logging level ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auto-seed initial demo fleet on empty database (true/false)
AUTO_SEED_DEMO=true

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

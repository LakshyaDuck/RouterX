# ==============================================================================
# RouterX - Backend Environment Configuration
# ==============================================================================

# PostgreSQL database connection string
# On Render: Render automatically provides this when you link a PostgreSQL database.
# Local Development: postgresql://postgres:postgres@localhost:5432/fleet_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet_db

# Deployment environment mode ('production', 'development', or 'test')
# On Render: RENDER=true is automatically set, defaulting to production.
ENVIRONMENT=production

# Server network binding
HOST=0.0.0.0
PORT=8000

# Logging level ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# Frontend URL for CORS (e.g. your Vercel deployment)
# The backend automatically allows https://router-x.vercel.app and *.vercel.app preview branches.
# Set this if you add a custom domain for your frontend:
FRONTEND_URL=https://router-x.vercel.app

# Additional comma-separated allowed CORS origins (optional)
CORS_ORIGINS=https://router-x.vercel.app,http://localhost:5173

# Auto-seed deterministic demo scenario on empty database (true/false)
AUTO_SEED_DEMO=true

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

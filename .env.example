# ==============================================================================
# RouterX - Production & Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env and customize for your deployment environment.
# DO NOT commit .env with real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
# Production connection string (e.g. from Render, AWS RDS, Neon, Supabase, Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet_db

# Credentials used when starting the database container via docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fleet_db
POSTGRES_PORT=5432

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# Backend Service Settings (e.g. Render)
# ------------------------------------------------------------------------------
# Environment: 'production', 'development', or 'test'
ENVIRONMENT=production

# Server network binding
HOST=0.0.0.0
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Frontend URL allowed for CORS (e.g. your Vercel deployment)
# The backend automatically allows https://router-x.vercel.app and *.vercel.app branches.
FRONTEND_URL=https://router-x.vercel.app

# Additional comma-separated allowed CORS origins (optional)
CORS_ORIGINS=https://router-x.vercel.app,http://localhost:5173

# Whether to auto-seed deterministic demo scenario (8 vehicles, 40 deliveries) on fresh database
AUTO_SEED_DEMO=true

# ------------------------------------------------------------------------------
# Frontend Service Settings (e.g. Vercel)
# ------------------------------------------------------------------------------
# Production Render backend URL used by the Vite frontend.
# Set this in Vercel project environment variables:
# VITE_API_URL=https://<your-render-backend-url>.onrender.com
# (VITE_API_BASE_URL is also supported as an alias)
VITE_API_URL=https://<your-backend-service-name>.onrender.com

# Local dev proxy target (only used when running Vite dev server locally without VITE_API_URL)
BACKEND_URL=http://localhost:8000

# Frontend port (local dev / Docker)
FRONTEND_PORT=5173

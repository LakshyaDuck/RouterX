# ==============================================================================
# RouterX - Production & Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env and customize for your deployment environment.
# DO NOT commit .env with real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
# Production connection string (e.g. from Render, AWS RDS, Neon, Supabase, Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet_db

# Credentials used when starting the database container via docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fleet_db
POSTGRES_PORT=5432

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# Backend Service Settings
# ------------------------------------------------------------------------------
# Environment: 'production', 'development', or 'test'
ENVIRONMENT=production

# Server network binding
HOST=0.0.0.0
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,http://localhost:5173)
# In production, set this to your exact frontend domain(s). Set to * only if public API access is desired.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Whether to auto-seed deterministic demo scenario (8 vehicles, 40 deliveries) on fresh database
AUTO_SEED_DEMO=true

# ------------------------------------------------------------------------------
# Frontend Service Settings
# ------------------------------------------------------------------------------
# Base API URL used by the frontend to communicate with backend.
# Default '/api' uses relative path (works with reverse proxy, Nginx, or Vite dev server).
# When deploying frontend on CDN/separate host, set to full API URL (e.g. https://api.example.com/api).
VITE_API_BASE_URL=/api

# Local dev proxy target (only used by Vite dev server)
BACKEND_URL=http://localhost:8000

# Frontend port
FRONTEND_PORT=5173

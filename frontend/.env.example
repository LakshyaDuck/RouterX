# ==============================================================================
# RouterX - Frontend Environment Configuration
# ==============================================================================

# API Base URL
# Default '/api' connects via reverse proxy or Vite dev server proxy.
# If hosting frontend separately on Vercel/Netlify/S3, set to full API backend endpoint:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

# Vite Development Server port
PORT=5173

# Vite Development Server reverse proxy target (local dev only)
BACKEND_URL=http://localhost:8000

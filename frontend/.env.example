# ==============================================================================
# RouterX - Frontend Environment Configuration (Vite)
# ==============================================================================

# Backend API URL
# In Vite, client-accessible environment variables MUST be prefixed with VITE_.
#
# For Production (e.g. deployed on Vercel connecting to Render backend):
# VITE_API_URL=https://<your-backend-service-name>.onrender.com
# (VITE_API_BASE_URL is also supported as an alias)
#
# For Local Development:
# Set to your local backend server:
# VITE_API_URL=http://localhost:8000
#
# If left empty or unset, the frontend defaults to '/api' which uses the Vite dev
# server proxy or Nginx reverse proxy.
VITE_API_URL=http://localhost:8000

# Vite Development Server port
PORT=5173

# Vite Development Server reverse proxy target (used when VITE_API_URL is unset)
BACKEND_URL=http://localhost:8000
